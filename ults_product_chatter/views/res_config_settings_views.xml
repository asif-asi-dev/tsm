<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product.tracking</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="95" />
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@id='warning_info']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box" id="product_field_tracking">
                        <div class="o_setting_right_pane">
                            <label for="product_tracking_mode" />
                            <div class="text-muted">
                                Configure which product fields should be tracked in chatter
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="product_tracking_mode" class="o_light_label"
                                        widget="radio" />
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
