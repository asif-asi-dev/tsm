<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Demo Product with Tracking Example -->
        <record id="product_product_demo_tracked" model="product.product">
            <field name="name">Demo Tracked Product</field>
            <field name="list_price">100.0</field>
            <field name="standard_price">50.0</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product.product_category_all" />
            <field name="sale_ok" eval="True" />
            <field name="purchase_ok" eval="True" />
            <field name="description">This is a demo product to showcase the tracking functionality
                of the ULTS Product Chatter module.</field>
        </record>

    </data>
</odoo>
